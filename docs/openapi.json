  "info": {
    "title": "LiDAR Backend API",
    "description": "Upload LAS/LAZ files directly to MinIO using multipart presigned URLs. 1. Initiate. 2. Presign parts. 3. PUT each binary part to its URL. 4. List parts to resume. 5. Complete to enqueue COPC processing. Parts are 16 MiB except the last; maximum file size is 1 GiB. MinIO must allow the browser origin and PUT, and expose ETag. Part URLs expire after 900 seconds; upload sessions after 24 hours. Do not send API JSON headers with binary PUT requests. Use Dataset APIs for metadata, status/progress, short-lived original/COPC download URLs and deletion. POST /datasets/{id}/requeue retries failed processing. Complete returns processingEnqueuePending when Redis is unavailable; reconciliation recovers automatically. Errors contain statusCode, error, message, timestamp and path.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "InitiateUploadDto": {
        "type": "object",
        "properties": {
          "originalFilename": {
            "type": "string",
            "example": "survey.laz",
            "maxLength": 255,
            "pattern": "\\.[lL][aA][sSzZ]$"
          },
          "fileSize": {
            "type": "number",
            "minimum": 1,
            "maximum": 1073741824,
            "example": 671811028,
            "description": "Size in bytes; maximum 1 GiB."
          }
        },
        "required": [
          "originalFilename",
          "fileSize"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "originalFilename": {
            "type": "string"
          },
          "fileSize": {
            "type": "string",
            "example": "671811028",
            "description": "Byte count as a decimal string (PostgreSQL bigint)."
          },
          "partSize": {
            "type": "number",
            "example": 16777216
          },
          "totalParts": {
            "type": "number",
            "example": 41
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "INITIATED",
              "UPLOADING",
              "COMPLETED",
              "ABORTED",
              "EXPIRED",
              "FAILED"
            ]
          }
        },
        "required": [
          "datasetId",
          "uploadSessionId",
          "originalFilename",
          "fileSize",
          "partSize",
          "totalParts",
          "expiresAt",
          "status"
        ]
      },
      "PresignPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "example": [
              1,
              2,
              3
            ],
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "Integer part numbers from 1 to totalParts (at most 10000).",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Temporary URL for a direct binary PUT to MinIO. Never log or persist it."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "PresignPartsResponseDto": {
        "type": "object",
        "properties": {
          "uploadSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresIn": {
            "type": "number",
            "example": 900
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          }
        },
        "required": [
          "uploadSessionId",
          "expiresIn",
          "parts"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "size": {
            "type": "number",
            "description": "Actual part size in MinIO."
          },
          "valid": {
            "type": "boolean",
            "description": "Whether this part has the expected byte count; reupload invalid parts."
          },
          "partNumber": {
            "type": "number"
          },
          "etag": {
            "type": "string",
            "description": "ETag reported by MinIO."
          }
        },
        "required": [
          "size",
          "valid",
          "partNumber",
          "etag"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "partSize": {
            "type": "number"
          },
          "totalParts": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "uploadSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadedParts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "partSize",
          "totalParts",
          "expiresAt",
          "uploadSessionId",
          "uploadedParts"
        ]
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPLOADING",
              "UPLOADED",
              "QUEUED",
              "PROCESSING",
              "READY",
              "FAILED",
              "DELETING"
            ]
          },
          "objectKey": {
            "type": "string"
          },
          "processingJobId": {
            "type": "string",
            "description": "Deterministic processing job identifier."
          },
          "processingEnqueuePending": {
            "type": "boolean",
            "description": "True when background reconciliation must retry enqueue."
          }
        },
        "required": [
          "datasetId",
          "uploadSessionId",
          "status",
          "objectKey",
          "processingEnqueuePending"
        ]
      },
      "AbortUploadResponseDto": {
        "type": "object",
        "properties": {
          "uploadSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "INITIATED",
              "UPLOADING",
              "COMPLETED",
              "ABORTED",
              "EXPIRED",
              "FAILED"
            ]
          }
        },
        "required": [
          "uploadSessionId",
          "status"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "timestamp",
          "path"
        ]
      },
      "DatasetResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "originalFilename": {
            "type": "string"
          },
          "fileFormat": {
            "type": "string",
            "enum": [
              "LAS",
              "LAZ",
              "COPC"
            ]
          },
          "fileSize": {
            "type": "string",
            "description": "Byte count encoded as a decimal bigint string."
          },
          "originalObjectKey": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "UPLOADING",
              "UPLOADED",
              "QUEUED",
              "PROCESSING",
              "READY",
              "FAILED",
              "DELETING"
            ],
            "description": "DELETING persists while storage cleanup is being retried."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "metadata.lidar contains original summary/metadata and processed COPC summary/metadata, objectKey, fileSize, processedAt."
          },
          "processingError": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "originalFilename",
          "fileFormat",
          "fileSize",
          "originalObjectKey",
          "status",
          "metadata",
          "processingError",
          "createdAt",
          "updatedAt"
        ]
      },
      "DatasetListResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetResponseDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      },
      "ProcessingProgressDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "attemptsMade": {
            "type": "number"
          }
        },
        "required": [
          "state",
          "progress",
          "attemptsMade"
        ]
      },
      "DatasetStatusResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPLOADING",
              "UPLOADED",
              "QUEUED",
              "PROCESSING",
              "READY",
              "FAILED",
              "DELETING"
            ]
          },
          "processingError": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "processing": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessingProgressDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "processingError",
          "updatedAt",
          "processing"
        ]
      },
      "DatasetDownloadResponseDto": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Temporary MinIO GET URL. Supports HTTP Range; do not persist or log."
          },
          "expiresIn": {
            "type": "number",
            "example": 300
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "fileSize": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "LAS",
              "LAZ",
              "COPC"
            ]
          },
          "rangeRequests": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "datasetId",
          "url",
          "expiresIn",
          "expiresAt",
          "fileSize",
          "format",
          "rangeRequests"
        ]
      },
      "RequeueResponseDto": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPLOADING",
              "UPLOADED",
              "QUEUED",
              "PROCESSING",
              "READY",
              "FAILED",
              "DELETING"
            ]
          },
          "processingJobId": {
            "type": "string"
          },
          "processingEnqueuePending": {
            "type": "boolean",
            "description": "When true the durable DB intent will be retried by reconciliation."
          }
        },
        "required": [
          "datasetId",
          "status",
          "processingJobId",
          "processingEnqueuePending"
        ]
      }
    }
  }
}
