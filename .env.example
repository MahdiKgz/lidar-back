NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lidar_user
DB_PASSWORD=local_dev_password
DB_NAME=lidar_db

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=lidar_admin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_REGION=us-east-1
MINIO_BUCKET=lidar-assets

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Must already be available locally; the backend never pulls or installs PDAL.
PDAL_DOCKER_IMAGE=ghcr.io/pdal/pdal@sha256:b7f250d102e68e67c2b35fbc63fa18f32ca248d5d42bea61e644a2e030afd6b0

REDIS_DB=0
REDIS_PASSWORD=
MINIO_CONFIGURE_BUCKET=false
PDAL_MODE=docker
PDAL_TIMEOUT_MS=3600000
PROCESSING_WORKER_ENABLED=true
PROCESSING_CONCURRENCY=1
